{
  "manifest_version": 3,
  "name": "EProject Score Auto-Fill",
  "version": "1.0.0",
  "description": "Ho tro dien diem, ghi chu hang loat, duyet diem va dong bo diem qua Firebase tren cac he thong cham diem dung chung domain e360.poly.edu.vn.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://e360.poly.edu.vn/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://fir-99209.firebaseio.com/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://e360.poly.edu.vn/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
